{
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm build",
  "outputDirectory": "apps/promo/.next",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}